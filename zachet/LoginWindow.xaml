<Window x:Class="zachet.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:zachet"
        mc:Ignorable="d"
        Title="Окно авторизации" Height="460" Width="360"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <StackPanel Margin="20">
        <TextBlock Text="Логин"/>
        <TextBox x:Name="loginTextBox" Margin="0,5,0,10" Height="24"/>

        <TextBlock Text="Пароль"/>
            <PasswordBox x:Name="passwordBox" Margin="0,5,0,10" Height="24"/>
        </StackPanel>

    <Button x:Name="loginButton" Content="Войти" Margin="0,250,0,10" Height="35" Width="225" Click="loginButton_Click"/>
    </Grid>
</Window>
